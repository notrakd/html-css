.layout {
    display: grid;
    grid-template-areas: 
    "header header header"
    "menu menu logo"
    "sidebar  content content"
    "news censorship button"
    "footer footer footer";
    grid-template-columns: 250px 1fr;
    grid-template-rows: 
    80px 60px 1fr 100px  70px;

    min-height: 100vh;
    gap: 10px;
}

.header{
    grid-area: header;
    background-color: #4a90e4;
    padding: 20px;
    color: white;
}

.menu{
    
    grid-area: menu;
    background-color: red;
    padding: 20px;
}

.logo{
    grid-area: logo;
    background-color: rgb(0, 252, 252);
    padding: 20px;
}

.sidebar{
    grid-area: sidebar;
    background-color: orange;
    padding: 20px;
}

.news{
    grid-area: news;
    background-color: blue;
    padding: 20px;
}

.censorship{
    grid-area: censorship;
    background-color: rgb(198, 231, 6);
    padding: 20px;
}

.button{
    grid-area: button;
    background-color: rgb(255, 11, 161);
    padding: 20px;
}

.content{
    grid-area: content;
    background-color: green;
    padding: 20px;
}


.footer{
    grid-area: footer;
    background-color: purple;
    padding: 20px;
    color: white;
}
